{
  "version": 1,
  "defaultMode": "build",
  "permissionProfile": "ask-dangerous",
  "providers": {
    "allow": ["anthropic", "openai", "openai-codex", "xai"],
    "favorites": [
      "anthropic/claude-sonnet-4-6",
      "openai-codex/gpt-5.4",
      "xai/grok-4.5"
    ]
  },
  "memory": {
    "enabled": true,
    "maxInjectChars": 6000,
    "autoLoad": true
  },
  "honesty": {
    "enabled": true
  },
  "skills": {
    "selfImprove": "approve",
    "maxComposeDepth": 3
  },
  "mcp": {
    "enabled": true,
    "connectOnStart": false
  },
  "fusion": {
    "architectModel": "anthropic/claude-sonnet-4-6",
    "builderModel": "openai-codex/gpt-5.4",
    "synthesizerModel": "anthropic/claude-opus-4-6",
    "architectEffort": "high",
    "builderEffort": "medium",
    "synthesizerEffort": "high"
  },
  "fission": {
    "models": [
      "anthropic/claude-sonnet-4-6",
      "openai-codex/gpt-5.4",
      "xai/grok-4.5",
      "anthropic/claude-opus-4-6",
      "openai-codex/gpt-5.4-mini"
    ],
    "judgeModel": "anthropic/claude-opus-4-8",
    "modelFamilies": {
      "anthropic/claude-sonnet-4-6": "claude",
      "openai-codex/gpt-5.4": "gpt",
      "xai/grok-4.5": "grok",
      "anthropic/claude-opus-4-6": "claude",
      "openai-codex/gpt-5.4-mini": "gpt",
      "anthropic/claude-opus-4-8": "claude"
    },
    "defaultReviewers": 3,
    "maxReviewers": 5,
    "blockingSeverity": "high"
  }
}
