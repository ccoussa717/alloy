{
  "name": "@kylaira/alloy",
  "version": "0.8.2",
  "description": "Alloy — multi-provider coding agent harness on Pi. Policy, memory, skills, MCP, multi-agent.",
  "type": "module",
  "bin": {
    "alloy": "./bin/alloy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/kylaira/infrastructure/alloy.git"
  },
  "homepage": "https://gitlab.com/kylaira/infrastructure/alloy",
  "bugs": {
    "url": "https://gitlab.com/kylaira/infrastructure/alloy/-/issues"
  },
  "keywords": [
    "pi-package",
    "coding-agent",
    "terminal-agent",
    "kylaira",
    "alloy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "assets",
    "bin",
    "extensions",
    "lib",
    "skills",
    "prompts",
    "themes",
    "config",
    "docs",
    "scripts",
    "install.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node ./bin/alloy.mjs",
    "alloy": "node ./bin/alloy.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test --test-force-exit test/integration/*.e2e.test.mjs",
    "test:all": "npm test && npm run test:integration",
    "doctor": "node -e \"import('./lib/providers.mjs').then(m=>console.log(m.formatFullDoctorReport()))\"",
    "setup": "bash ./install.sh",
    "install-cli": "bash ./scripts/install-cli.sh",
    "bootstrap": "bash ./install.sh",
    "version:print": "node ./bin/alloy.mjs --version",
    "ci:local": "node -e \"const [a,b]=process.versions.node.split('.').map(Number); if(a<22||(a===22&&b<19)) process.exit(1)\" && npm run test:all && node ./bin/alloy.mjs --version && npm pack --dry-run >/dev/null && npm run security:scan",
    "security:scan": "bash ./scripts/security-scan.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typebox": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
