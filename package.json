{
  "name": "@kylaira/alloy",
  "version": "0.1.0",
  "description": "Alloy — multi-provider coding harness on Pi. Subscriptions, durable memory, skills, MCP.",
  "type": "module",
  "bin": {
    "alloy": "./bin/alloy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/kylaira/infrastructure/alloy.git"
  },
  "homepage": "https://gitlab.com/kylaira/infrastructure/alloy",
  "bugs": {
    "url": "https://gitlab.com/kylaira/infrastructure/alloy/-/issues"
  },
  "keywords": [
    "pi-package",
    "coding-agent",
    "terminal-agent",
    "kylaira",
    "alloy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "extensions",
    "lib",
    "skills",
    "prompts",
    "themes",
    "config",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "doctor": "node bin/alloy.mjs --help",
    "link-local": "npm link && npm link -g @earendil-works/pi-coding-agent"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
