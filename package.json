{
  "name": "alloy-agent",
  "version": "1.1.25",
  "description": "Alloy multi-provider coding agent with an OpenCode-derived Solid/OpenTUI frontend and Pi runtime.",
  "private": true,
  "type": "module",
  "bin": {
    "alloy": "bin/alloy.mjs"
  },
  "keywords": [
    "pi-package",
    "coding-agent",
    "terminal-agent",
    "alloy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccoussa717/alloy.git"
  },
  "homepage": "https://github.com/ccoussa717/alloy#readme",
  "bugs": {
    "url": "https://github.com/ccoussa717/alloy/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin",
    "extensions",
    "lib",
    "skills",
    "prompts",
    "themes",
    "tui/assets",
    "tui/bun.lock",
    "tui/bunfig.toml",
    "tui/package.json",
    "tui/patches",
    "tui/src",
    "tui/LICENSE.opencode",
    "tui/THIRD_PARTY_NOTICES.md",
    "tui/UPSTREAM.md",
    "config",
    "docs/*.md",
    "docs/assets",
    "scripts",
    "install.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node ./bin/alloy.mjs",
    "alloy": "node ./bin/alloy.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:tui": "bun --cwd tui test",
    "typecheck:tui": "bun run --cwd tui typecheck",
    "verify:tui:pty": "bun run --cwd tui verify:pty",
    "verify:opentui-packed": "bash ./scripts/verify-opentui-packed.sh",
    "test:integration": "node --test --test-force-exit test/integration/*.e2e.test.mjs",
    "test:installer": "ALLOY_RUN_SOURCE_INSTALLER_E2E=1 node --test --test-name-pattern=\"source installer\" test/integration/packed-install.e2e.test.mjs",
    "bench:swebench:test": "python3 -m unittest discover -s benchmarks/swebench/tests -v",
    "bench:swebench:setup": "python3 -m venv benchmarks/swebench/.venv && benchmarks/swebench/.venv/bin/python -m pip install --upgrade pip && benchmarks/swebench/.venv/bin/python -m pip install -r benchmarks/swebench/requirements.txt",
    "bench:swebench:dry-run": "bash scripts/run-swebench-release-smoke.sh --dry-run",
    "bench:swebench:release": "bash scripts/run-swebench-release-smoke.sh",
    "test:all": "npm test && npm run bench:swebench:test && npm run typecheck:tui && npm run test:tui && npm run verify:tui:pty && npm run test:integration && npm run test:installer",
    "tui:install": "bun install --cwd tui --frozen-lockfile",
    "doctor": "node -e \"import('./lib/providers.mjs').then(m=>console.log(m.formatFullDoctorReport()))\"",
    "setup": "npm ci && npm run tui:install && npm link",
    "install-cli": "bash ./scripts/install-cli.sh",
    "bootstrap": "npm ci && npm run tui:install && npm link",
    "version:print": "node ./bin/alloy.mjs --version",
    "ci:checks": "node -e \"const [a,b]=process.versions.node.split('.').map(Number); if(a<22||(a===22&&b<19)) process.exit(1)\" && npm run test:all && node ./bin/alloy.mjs --version && npm run release:verify:tui && npm run security:scan && npm run sbom:write",
    "ci:local": "npm run ci:checks && npm run release:verify:source",
    "ci:release": "npm run ci:checks && npm run audit:release",
    "security:scan": "bash ./scripts/security-scan.sh",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:verify:source": "node ./scripts/verify-release.mjs --source",
    "release:verify:publish": "node ./scripts/verify-release.mjs --publish",
    "release:verify:tui": "node ./scripts/verify-tui-release.mjs",
    "shrinkwrap:normalize": "node ./scripts/normalize-shrinkwrap.mjs",
    "audit:release": "status=0; npm audit --omit=dev --audit-level=high || status=1; (cd tui && bun audit --production --audit-level=high) || status=1; exit $status",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "sbom:write": "npm run --silent sbom > alloy.cdx.json && node ./scripts/merge-tui-sbom.mjs alloy.cdx.json tui/bun.lock && node -e \"const b=require('./alloy.cdx.json'); if(b.bomFormat!=='CycloneDX'||!b.specVersion||!b.components.some(c=>c.name==='@opentui/core')||!b.components.some(c=>c.name==='solid-js')) process.exit(1)\"",
    "prepublishOnly": "node -e \"console.error('npm publication and package-consumer interactive install are unsupported until an explicit Bun lifecycle design is approved'); process.exit(1)\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-ai-0.82.1.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-coding-agent-0.82.1.tgz",
    "@earendil-works/pi-tui": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-tui-0.82.1.tgz",
    "@modelcontextprotocol/sdk": "1.29.0",
    "typebox": "1.1.38"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "8.10.0",
    "@earendil-works/pi-coding-agent": {
      "@earendil-works/pi-agent-core": "0.82.1",
      "@earendil-works/pi-ai": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-ai-0.82.1.tgz",
      "@earendil-works/pi-tui": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-tui-0.82.1.tgz"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "alloy": {
    "piFork": {
      "version": "0.82.1",
      "commit": "efd4e85da934ffa1e4161d0a08bd861ca8401ba4",
      "url": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-coding-agent-0.82.1.tgz",
      "sha256": "0da9289c9c76b4c5762d0dfa37910cea3a4b2307e373f293a01cdbd813288be9",
      "integrity": "sha512-bRgcHLQKyDsCa+FwB/s3f7a02ogtAKXNcJZ3YoJg5abl/VCa8JZvomYmjw6HvTbb/lGCfbE01o6gQReDZ5oiHw==",
      "ai": {
        "url": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-ai-0.82.1.tgz",
        "sha256": "ec2a9bac0a16fafcb5d3071b7a8ea058865c7ee232972fb562c55135a12a85b3",
        "integrity": "sha512-v0fBjXGCsAk+CLgHfF4wGzRGN0eW+J2D2mX8QQR/wIBBGmljxtDVymOdflD0z7R5tQJg/GKRhO4QYjqt90/8Ag=="
      },
      "tui": {
        "url": "https://github.com/ccoussa717/pi/releases/download/alloy-tui-v0.82.1.10/earendil-works-pi-tui-0.82.1.tgz",
        "sha256": "6c939c4515c6742895e4d4c6e5926a5c735a7789d20250284dbef510efa5959c",
        "integrity": "sha512-0fP+idwxLCNq8a/C6CwIZ6e5B1xPck/ndxD2CSyrmhkaoPxEgY190WIGcIPHGNx51IAlDU7jHkwcOaN5MExpTQ=="
